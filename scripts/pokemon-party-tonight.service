[Unit]
Description=Pokemon Party Tonight
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/pokemon-party-tonight
Environment=NODE_ENV=production
Environment=PORT=3100
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/node /home/ubuntu/pokemon-party-tonight/dist/server.cjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
